+    CFMutableArrayRef         audio_queue;   // audio frames waiting behind current_audio_frame
 
     AVCaptureDevice          *observed_device;
 #if !TARGET_OS_IPHONE && __MAC_OS_X_VERSION_MIN_REQUIRED >= 1070
@@ -273,12 +274,18 @@
 {
     lock_frames(_context);
 
-    if (_context->current_audio_frame != nil) {
-        CFRelease(_context->current_audio_frame);
+    // Queue audio frames instead of overwriting the one not read yet: the reader takes
+    // video first, so a single slot loses audio whenever a video frame is being copied.
+    if (_context->current_audio_frame == nil) {
+        _context->current_audio_frame = (CMSampleBufferRef)CFRetain(audioFrame);
+    } else {
+        if (!_context->audio_queue)
+            _context->audio_queue = CFArrayCreateMutable(NULL, 0, &kCFTypeArrayCallBacks);
+        if (CFArrayGetCount(_context->audio_queue) >= 1000)
+            CFArrayRemoveValueAtIndex(_context->audio_queue, 0);
+        CFArrayAppendValue(_context->audio_queue, audioFrame);
     }
 
-    _context->current_audio_frame = (CMSampleBufferRef)CFRetain(audioFrame);
-
     unlock_frames(_context);
 
